# Create a GitHub App and set its setup URL to:
# http://localhost:3000/api/auth/github/callback
# Required permissions: Contents read/write; Pull requests read/write.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\\n...\\n-----END RSA PRIVATE KEY-----"
# Local-only alternative: absolute path to a GitHub App PEM file. Do not set both.
# GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/private-key.pem
# Generate with: openssl rand -base64 32
APP_SESSION_SECRET=
# Optional local run persistence path
# RUN_STORE_PATH=/absolute/path/to/verimodern-runs.json
